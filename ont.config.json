  "mergeGate": {
    "paths": [
      ".github/",
      ".githooks/",
      "package.json",
      "tools/ont-check/",
      "ont.config.json",
      "example/ont.config.json",
      "templates/",
      "example/app/*.test.mjs",
      "example/e2e/",
      "example/traces/",
      "example/judged/",
      "example/app/adapter.mjs"
    ],
    "rules": ".github/merge-gate.json",
    "codes": {
      "enforcement-merge-gate": [
        "GATE_PATH_UNAPPROVED"
      ],
      "enforcement-tool-records": [
        "SEAL_MISSING",
        "SEAL_WRONG",
        "RECORD_CHANGED",
        "RECORD_REMOVED"
      ],
      "enforcement-task-state": [
        "TASK_UNNAMED",
        "TASK_NOT_DONE",
        "TASK_HEAD_UNREVIEWED",
        "WORK_BEFORE_APPROVAL",
        "MERGE_UNPERMITTED",
        "GATE_PATH_OUTSIDE_APPROVAL",
        "RULES_DRIFT",
        "RULES_UNREAD"
      ],
      "enforcement-verdicts-tests": ["VERDICT_MISSING", "VERDICT_FAILED", "VERDICT_UNREASONED", "VERDICT_NOT_OF_CHANGE", "ISSUE_MISSING", "FIX_UNTESTED"]
    },
    "taskState": true,
    "verdicts": true
  },
  "ci": {
    "workflow": ".github/workflows/ont-check.yml"
  },
  "protocolReleases": {
    "file": "releases.md"
  },
