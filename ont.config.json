{
  "classes": {
    "ent": "Entity",
    "field": "Field",
    "edge": "Relation",
    "derived": "Derived",
    "concept": "Concept",
    "rule": "Rule",
    "inv": "Invariant",
    "hook": "Hook",
    "action": "Action",
    "view": "View"
  },
  "scoped": [
    "field",
    "edge"
  ],
  "ontology": "ontology.md",
  "headings": {
    "implementation": "## Implementation status",
    "retired": "## Retired IDs"
  },
  "root": ".",
  "agentInstructions": ["AGENTS.md", "CLAUDE.md"],
  "approachIds": {
    "out": "tools/ont-check/approach.json"
  },
  "decisions": {
    "file": "decisions.md"
  },
  "contracts": {
    "out": "contracts/approach.schema.json",
    "propertyCase": "camel"
  },
  "tickets": {
    "dir": "issues"
  },
  "checks": {
    "file": "checks.md",
    "require": [
      "inv",
      "rule"
    ]
  },
  "testSuites": [
    {
      "name": "tool",
      "dir": "tools/ont-check/test",
      "match": "\\.test\\.mjs$",
      "cover": []
    }
  ],
  "external": [
    {
      "ontology": "example/ontology.md",
      "checks": "example/checks.md"
    },
    {
      "ontology": "templates/ontology.md",
      "checks": "templates/checks.md"
    }
  ],
  "docSets": [
    {
      "name": "approach",
      "dir": "docs",
      "cover": [
        "ent",
        "rule",
        "inv",
        "action"
      ],
      "scope": "all"
    }
  ],
  "references": [
    {
      "out": "docs/reference.md",
      "title": "Reference",
      "intro": "Every concept of the approach, its type and definition, and the checks that hold it, generated from [ontology.md](../ontology.md) and [checks.md](../checks.md). Automatic checks are enforced by the tool; manual checks are what a reviewer does, because the tool cannot. The pages of this directory explain the parts; this page is what they refer to.",
      "ids": true,
      "kinds": true,
      "types": true,
      "checks": true
    }
  ]
}
