#!/bin/sh
# After a merge, rewrites the ontology tree at the place this clone names in its own Git configuration
# (git config --local ont.treeOut <path>), when the merge was into main (D-105, D-120). Git passes 1 when
# the merge was a squash, which leaves main where it was. The merge is done whatever happens here, so an
# error of the generator is printed and the hook still ends with 0. Where the clone names a place on
# main and the generator is missing from the working tree, the hook says so with the command that
# restores it; elsewhere a missing generator is nobody's tree, and the hook says nothing.
# ont: rule.tree-refreshed-after-merge, field.ontology-tree.place
GEN=tools/ont-check/gen-tree.mjs
if [ ! -f "$GEN" ]; then
  if [ -n "$(git config --local --get ont.treeOut)" ] && [ "$(git symbolic-ref --quiet HEAD)" = refs/heads/main ]; then
    echo "post-merge: the ontology tree was not written: $GEN is missing from the working tree; restore it with git restore $GEN, then run node $GEN --refresh" >&2
  fi
  exit 0
fi
if [ "$1" = 1 ]; then
  node "$GEN" --refresh --squash || echo "post-merge: the ontology tree was not written; the merge itself is done" >&2
else
  node "$GEN" --refresh || echo "post-merge: the ontology tree was not written; the merge itself is done" >&2
fi
exit 0
