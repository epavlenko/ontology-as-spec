    "out": "contracts/ontology.schema.json",
    "propertyCase": "camel"
  },
  "mockup": [
    "mockup/index.html"
  ],
  "map": {
    "file": "mockup/ontology-map.md",
    "idColumn": 2
  },
  "checks": {
    "file": "checks.md",
    "require": [
      "inv",
      "rule",
      "hook",
      "action"
    ]
  },
  "tickets": {
    "dir": ".",
    "match": "^issue\\.md$"
  },
  "notYetShown": [
    "view",
    "action",
    "field",
    "derived",
    "concept"
  ],
  "scoped": [
    "field",
    "edge"
  ],
  "docSets": [
    {
      "name": "help",
      "dir": "help",
      "cover": [
        "action",
        "view"
      ],
      "scope": "all"
    }
  ],
  "references": [
    {
      "out": "help/terms.md",
      "title": "Terms",
      "intro": "Every word the product uses, with its meaning.",
      "classes": [
        "ent",
        "field",
        "derived",
        "concept",
        "rule",
        "inv",
        "action",
        "view"
      ]
    }
  ]
