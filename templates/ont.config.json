    "inv": "Invariant",
    "hook": "Hook",
    "action": "Action",
    "view": "View"
  },
  "ontology": "ontology.md",
  "headings": {
    "implementation": "## Implementation status",
    "retired": "## Retired IDs"
  },
  "root": ".",
