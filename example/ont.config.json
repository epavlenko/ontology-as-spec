{
  "classes": {
    "ent": "Entity",
    "field": "Field",
    "edge": "Relation",
    "derived": "Derived",
    "concept": "Concept",
    "rule": "Rule",
    "inv": "Invariant",
    "hook": "Hook",
    "action": "Action",
    "view": "View"
  },
  "ontology": "ontology.md",
  "headings": {
    "implementation": "## Implementation status",
    "retired": "## Retired IDs"
  },
  "root": ".",
  "agentInstructions": ["AGENTS.md"],
  "code": [{ "dir": "app", "match": "^(?!.*\\.test\\.mjs$).*\\.mjs$" }],
  "codeNames": { "owner": true },
  "decisions": {
    "file": "decisions.md",
    "entry": "^### (D-\\d+) \u00b7 .+$",
    "ref": "\\bD-\\d+\\b"
  },
  "glossaryOut": "mockup/ontology.js",
  "contracts": {
    "out": "contracts/ontology.schema.json",
    "propertyCase": "camel"
  },
  "mockup": [
    "mockup/index.html"
  ],
  "map": {
    "file": "mockup/ontology-map.md",
    "idColumn": 2
  },
  "checks": {
    "file": "checks.md",
    "require": [
      "inv",
      "rule",
      "hook",
      "action"
    ],
    "axes": ["outcome"]
  },
  "testSuites": [
    {
      "name": "unit",
      "dir": "app",
      "match": "\\.test\\.mjs$",
      "cover": [
        "inv",
        "rule",
        "derived"
      ]
    },
    {
      "name": "end-to-end",
      "dir": "e2e",
      "match": "\\.test\\.mjs$",
      "cover": [
        "action",
        "view"
      ]
    },
    {
      "name": "judged",
      "dir": "judged",
      "match": "\\.judged\\.mjs$",
      "cover": [],
      "checks": [
        "check.member.limit-refusal-explained"
      ]
    }
  ],
  "tickets": {
    "dir": "issues"
  },
  "notYetShown": [
    "view",
    "action",
    "field",
    "derived",
    "concept"
  ],
  "scoped": [
    "field",
    "edge"
  ],
  "docSets": [
    {
      "name": "help",
      "dir": "help",
      "cover": [
        "action",
        "view",
        "rule"
      ],
      "scope": "implemented"
    },
    {
      "name": "verify",
      "dir": "verify",
      "cover": [],
      "checks": [
        "manual"
      ],
      "scope": "implemented"
    }
  ],
  "references": [
    {
      "out": "help/terms.md",
      "title": "Terms",
      "intro": "Every word the library app uses, with its meaning. Only what the app does today is listed.",
      "classes": [
        "ent",
        "field",
        "derived",
        "concept",
        "rule",
        "inv",
        "action",
        "view"
      ],
      "implementedOnly": true
    }
  ]
}
